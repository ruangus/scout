{
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."],
      "format_on_save": "on",
      "formatter": [{ "code_action": "source.fixAll.oxc" }]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."],
      "format_on_save": "on",
      "formatter": [{ "code_action": "source.fixAll.oxc" }]
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": [{ "code_action": "source.fixAll.oxc" }]
    }
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "package_version": "7.0.2"
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onSave",
          "fixKind": "safe_fix"
        }
      }
    }
  }
}
